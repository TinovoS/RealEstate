{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "users": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "brokers": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/brokers/{**catch-all}" }
      },
      "properties": {
        "ClusterId": "property",
        "Match": { "Path": "/api/properties/{**catch-all}" }
      },
      "broker-offers": {
        "ClusterId": "brokerage",
        "Match": { "Path": "/api/broker-offers/{**catch-all}" }
      },
      "contracts": {
        "ClusterId": "brokerage",
        "Match": { "Path": "/api/contracts/{**catch-all}" }
      },
      "brokerage": {
        "ClusterId": "brokerage",
        "Match": { "Path": "/api/brokerage/{**catch-all}" }
      },
      "bids": {
        "ClusterId": "sales",
        "Match": { "Path": "/api/bids/{**catch-all}" }
      },
      "transactions": {
        "ClusterId": "sales",
        "Match": { "Path": "/api/transactions/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": { "d1": { "Address": "http://localhost:5001/" } }
      },
      "property": {
        "Destinations": { "d1": { "Address": "http://localhost:5002/" } }
      },
      "brokerage": {
        "Destinations": { "d1": { "Address": "http://localhost:5003/" } }
      },
      "sales": {
        "Destinations": { "d1": { "Address": "http://localhost:5004/" } }
      }
    }
  }
}
